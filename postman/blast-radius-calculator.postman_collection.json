{
  "info": {
    "name": "Blast Radius Calculator Postman Collection",
    "description": "Pre-deployment impact analysis engine. Before a change reaches production, \ncalculates exactly how many users, revenue, regions, and downstream services \nwould be affected if it goes wrong. Uses the service dependency graph, live \ntraffic patterns, customer tiers, and revenue attribution to answer the \nquestion every release manager asks: \"What's the worst-case scenario?\"\nProvides data-driven recommendations for canary percentage, rollback \ntriggers, and deploy timing.\n\nOpenAPI version: 3.0.3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
